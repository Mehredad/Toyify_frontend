Upload-First Flow Implementation
Cache Strategy (Pre-Auth)
localStorage Schema
typescriptinterface CachedUpload {
  imageDataUrl: string; // base64
  story: string;
  timestamp: number;
  expiresAt: number; // 1 hour expiry
}

// Save to cache
const saveToCache = (imageFile: File, story: string) => {
  const reader = new FileReader();
  reader.onload = (e) => {
    const cached: CachedUpload = {
      imageDataUrl: e.target?.result as string,
      story,
      timestamp: Date.now(),
      expiresAt: Date.now() + 3600000 // 1 hour
    };
    localStorage.setItem('toyify_pending_upload', JSON.stringify(cached));
  };
  reader.readAsDataURL(imageFile);
};
Post-Auth Transfer Flow
typescriptconst transferCachedUpload = async (userId: string) => {
  const cached = localStorage.getItem('toyify_pending_upload');
  if (!cached) return;

  const { imageDataUrl, story } = JSON.parse(cached);
  
  // Convert base64 back to File
  const blob = await fetch(imageDataUrl).then(r => r.blob());
  const file = new File([blob], 'drawing.png', { type: 'image/png' });

  // Upload to Supabase Storage
  const { data: uploadData, error } = await supabase.storage
    .from('drawings')
    .upload(`${userId}/${Date.now()}.png`, file);

  if (error) throw error;

  // Save to database
  const { data: imageRecord } = await supabase
    .from('uploaded_images')
    .insert({
      user_id: userId,
      original_drawing_url: uploadData.path,
      original_story: story
    })
    .select()
    .single();

  // Trigger AI generation
  await generateConcept(imageRecord.id, userId);

  // Clear cache
  localStorage.removeItem('toyify_pending_upload');
};
Background Generation Pattern
typescriptconst generateConcept = async (imageId: string, userId: string) => {
  // Check eligibility first
  const eligibility = await checkGenerationEligibility(userId);
  if (!eligibility.canGenerate) {
    throw new Error(eligibility.message);
  }

  // Show loading state to user
  toast.loading('Creating your toy concept...', { id: 'generation' });

  // Digitize with LightX
  const digitizedUrl = await lightxAPI.digitize(imageId);

  // Generate 3D concept
  const concept3dUrl = await generate3D(digitizedUrl);

  // Enhance story
  const enhancedStory = await enhanceStory(originalStory);

  // Save concept
  const { data: concept } = await supabase
    .from('generated_concepts')
    .insert({
      image_id: imageId,
      user_id: userId,
      concept_3d_url: concept3dUrl,
      enhanced_story: enhancedStory,
      used_credit: eligibility.paidCredits > 0
    })
    .select()
    .single();

  // Update credits
  await updateUserCredits(userId, eligibility.paidCredits > 0);

  // Redirect to concept view
  toast.success('Your toy is ready!', { id: 'generation' });
  router.push(`/concept/${concept.id}`);
};

