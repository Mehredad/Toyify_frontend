Generation Limits & Credits System
Business Logic
Daily Free Limits

First 2 generations per day: FREE
After first 2: 1 generation per 24 hours (FREE)
Resets at midnight UTC

Credit System

Purchase: £5 = 5 generation credits
Usage priority: Paid credits used before daily free limit
No expiration: Credits persist indefinitely

Rate Limiting Algorithm
typescriptasync function checkGenerationEligibility(userId: string): Promise<{
  canGenerate: boolean;
  remainingFree: number;
  paidCredits: number;
  nextFreeAt?: Date;
  message: string;
}> {
  const { data: credits } = await supabase
    .from('user_credits')
    .select('*')
    .eq('user_id', userId)
    .single();

  const today = new Date().toISOString().split('T')[0];
  const isNewDay = credits.last_generation_date !== today;

  if (isNewDay) {
    // Reset daily counter
    credits.daily_generations_used = 0;
  }

  // Check paid credits first
  if (credits.total_credits > 0) {
    return {
      canGenerate: true,
      remainingFree: isNewDay ? 2 : Math.max(0, 2 - credits.daily_generations_used),
      paidCredits: credits.total_credits,
      message: `You have ${credits.total_credits} paid credits remaining.`
    };
  }

  // Check daily free limit
  if (credits.daily_generations_used < 2) {
    return {
      canGenerate: true,
      remainingFree: 2 - credits.daily_generations_used,
      paidCredits: 0,
      message: `You have ${2 - credits.daily_generations_used} free generations remaining today.`
    };
  }

  // Calculate next free generation time (24 hours from last)
  const nextFree = new Date(credits.last_generation_date);
  nextFree.setHours(nextFree.getHours() + 24);

  return {
    canGenerate: false,
    remainingFree: 0,
    paidCredits: 0,
    nextFreeAt: nextFree,
    message: `Next free generation available in ${getTimeRemaining(nextFree)}.`
  };
}
